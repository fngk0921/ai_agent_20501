# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올리지 마세요)
PORT=4000

# 로그인 쿠키 서명용. 비워 두면 서버 재시작마다 모두 로그아웃됩니다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# 모델 (선택, OpenAI 모델 ID). 기본은 모든 에이전트가 gpt-6-luna
# DEFAULT_MODEL=gpt-6-luna
# EXPLORE_MODEL=
# LIBRARIAN_MODEL=
# ORACLE_MODEL=
# FRONTEND_MODEL=

# DB 선택: sqlite 또는 mysql. 이름은 ai_agent_20501
# sqlite → server/data/ai_agent_20501.db 파일 (없으면 생성)
# mysql  → 아래 서버에 ai_agent_20501 데이터베이스 (없으면 생성)
# 두 경우 모두 테이블이 없으면 자동으로 만든다.
DB_CLIENT=sqlite
DB_NAME=ai_agent_20501
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
